// =============================================================================
// BERGER IRON WORKS — STEEL ESTIMATOR DATABASE SCHEMA
// =============================================================================
// This file describes every "table" (model) in your database.
// Think of each model as a drawer in a filing cabinet.
// Each field is a column on a spreadsheet inside that drawer.
//
// After editing this file, run:  npx prisma migrate dev --name describe_change
// That tells PostgreSQL to build/update the actual tables.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USER & AUTHENTICATION
// =============================================================================
// Who can log in and what they're allowed to do.
// role: ADMIN = full access, ESTIMATOR = create/edit/lock, PM = read-only

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  firstName   String    @default("")
  lastName    String    @default("")
  role        String    @default("ESTIMATOR") // ADMIN, ESTIMATOR, PM, FIELD_SHOP
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  projects            Project[] @relation("CreatedBy")
  publishedProjects   Project[] @relation("PublishedBy")
  estimatedProjects   Project[] @relation("EstimatorProjects")
  notifications       Notification[] @relation("UserNotifications")
  activities          CustomerActivity[]
}

// =============================================================================
// PROJECT
// =============================================================================
// One project = one estimate. This is the top-level record that holds
// everything together — like the project folder that contains all your sheets.

model Project {
  id               Int       @id @default(autoincrement())
  
  // Status: DRAFT, IN_REVIEW, PUBLISHED, REOPENED
  status           String    @default("DRAFT")
  publishedAt      DateTime?
  
  // Project Info tab fields
  projectName      String    @default("")
  projectAddress   String    @default("")
  customerName     String    @default("")
  billingAddress   String    @default("")
  customerContact  String    @default("")
  customerPhone    String    @default("")
  customerEmail    String    @default("")
  estimateDate     String    @default("")
  estimatedBy      String    @default("")
  drawingDate      String    @default("")
  drawingRevision  String    @default("")
  architect        String    @default("")
  
  // Project types (checkboxes)
  typeStructural    Boolean  @default(false)
  typeMiscellaneous Boolean  @default(false)
  typeOrnamental    Boolean  @default(false)
  
  // Delivery options (checkboxes)
  deliveryInstalled  Boolean @default(false)
  deliveryFobJobsite Boolean @default(false)
  deliveryWillCall   Boolean @default(false)
  
  // Tax category: null, "newConstruction", "resale", "fob", "noTax"
  taxCategory      String?

  // Template project: not a bid — a living reference estimate (e.g. "Connx
  // Template") whose item totals feed pricing lookups via sync.
  isTemplate       Boolean   @default(false)

  // Cross-item stock nesting: pool cut lengths across items onto shared sticks
  nestingEnabled   Boolean   @default(false)
  nestKerfIn       Float     @default(0.25)  // saw kerf per cut, inches
  nestEndCropIn    Float     @default(0)     // end crop per stick, inches

  // Supplier stock-length availability per size, JSON: { "W12x26": [40,60], ... }
  // Absent size = category standard lengths.
  stockLengthOverrides String @default("{}")

  // ── DASHBOARD / BID BOARD FIELDS ─────────────────────────────────────────
  // dashboardStatus tracks where this project sits in the bid pipeline.
  // Valid values: "Bidding" | "Quoted - Pending Award from GC" |
  //               "Quoted - Budget Only" | "Awarded to BIW" |
  //               "Redesign omitted scope"
  dashboardStatus  String?

  // newOrCo: whether this is a new project or a change order.
  // Valid values: "NEW_PROJECT" | "CHANGE_ORDER"
  newOrCo          String?

  description      String?   // Free-text project description
  notes            String?   // Internal notes
  bidDate          DateTime? // When the bid is due
  bidTime          String    @default("") // Time the bid is due (HH:MM, 24-hr)
  startDate        DateTime? // Projected or actual start date
  bidAmount        Float?    // Dollar amount of the bid (nullable; may be calculated)
  isArchived       Boolean   @default(false)

  // estimatorId: who is assigned to estimate this project (may differ from createdBy)
  estimatorId      Int?
  estimator        User?     @relation("EstimatorProjects", fields: [estimatorId], references: [id])

  // NOTE: estimateDate already exists above as a String field ("" default).
  // It is NOT duplicated here. If a DateTime version is needed in the future,
  // a migration to rename/convert that field would be required.

  // ── TIMESTAMPS & TRACKING ────────────────────────────────────────────────
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Who created this project
  createdById      Int
  createdBy        User      @relation("CreatedBy", fields: [createdById], references: [id])

  // Who published this project
  publishedById    Int?
  publishedBy      User?     @relation("PublishedBy", fields: [publishedById], references: [id])
  
  // If this is a revision, link back to the original
  parentProjectId  Int?
  parentProject    Project?  @relation("ProjectRevisions", fields: [parentProjectId], references: [id])
  revisions        Project[] @relation("ProjectRevisions")
  
  // CRM link (optional — customer may not be set)
  customerId           Int?
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Everything inside this project
  items                Item[]
  breakoutGroups       BreakoutGroup[]
  adjustments          Adjustment[]
  exclusions           Exclusion[]
  qualifications       Qualification[]
  customRecapColumns   CustomRecapColumn[]
  notifications        Notification[]
  customProjectTypes   CustomProjectType[]
  customDeliveryOptions CustomDeliveryOption[]
  customerActivities   CustomerActivity[]

  @@index([createdById])
  @@index([estimatorId])
  @@index([customerId])
}

// =============================================================================
// BREAKOUT GROUP
// =============================================================================
// Groups items into Base Bid, Deduct, or Add alternates on the quote.
// Example: "Canopy" might be a Deduct option.

model BreakoutGroup {
  id        Int     @id @default(autoincrement())
  name      String  @default("")
  type      String  @default("base") // "base", "deduct", "add"
  
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  items     Item[]
}

// =============================================================================
// ITEM
// =============================================================================
// A single line item in the estimate. Example: "Stair #1" or "Canopy Framing"
// Each item has its own materials, fabrication, and recap costs.

model Item {
  id              Int     @id @default(autoincrement())
  itemNumber      String  @default("001")
  itemName        String  @default("New Item")
  drawingRef      String  @default("")
  sortOrder       Int     @default(0)        // Controls display order
  materialMarkup  Float   @default(0)        // Percentage
  fabMarkup       Float   @default(0)        // Percentage
  priceStandalone Boolean @default(false)    // Exclude from cross-item nesting (alternates)
  
  projectId       Int
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  breakoutGroupId Int?
  breakoutGroup   BreakoutGroup? @relation(fields: [breakoutGroupId], references: [id], onDelete: SetNull)
  
  // Everything inside this item
  materials       Material[]
  fabrication     ItemFabrication[]
  recapCosts      RecapCost[]
  snapshots       ItemSnapshot[]
  laborGroups     LaborGroup[]

  @@index([projectId, sortOrder])
}

// =============================================================================
// MATERIAL
// =============================================================================
// A single material line within an item. Example: "W12x26 at 20'-0" — 4 pieces"
// This stores the shape, size, length, quantity, pricing, and weight calculations.

model Material {
  id             Int     @id @default(autoincrement())
  sortOrder      Int     @default(0)
  
  // What shape and size
  category       String  @default("")     // "W Shapes", "HSS Rect", "Plate", etc.
  shape          String  @default("")     // "W12x26", "HSS6x4x1/4", etc.
  description    String  @default("")     // User-entered label (especially for custom/misc categories)

  // Dimensions and quantity
  length         Float   @default(0)      // Piece length in feet
  pieces         Int     @default(0)      // How many pieces
  
  // Stock / nesting
  stockLength    Float   @default(0)      // Stock length purchased
  stocksRequired Int     @default(0)      // How many stocks to buy
  waste          Float   @default(0)      // Waste percentage
  
  // Weight
  weightPerFt    Float   @default(0)      // Lbs per linear foot
  fabWeight      Float   @default(0)      // Total fabrication weight
  stockWeight    Float   @default(0)      // Total stock weight purchased
  
  // Pricing
  priceBy        String  @default("LB")   // "LB", "LF", or "EA"
  unitPrice      Float   @default(0)      // Cost per unit (per lb, per ft, or per ea)
  pricePerFt     Float   @default(0)      // Cost per foot
  pricePerLb     Float   @default(0)      // Cost per pound
  totalCost      Float   @default(0)      // Calculated total material cost

  // Galvanizing
  galvanized     Boolean @default(false)
  galvRate       Float   @default(0)

  // Plate-specific fields
  width          Float?                   // Plate width in inches
  thickness      Float?                   // Plate thickness in inches

  // Parent relationship
  itemId         Int
  item           Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Subpart linkage (the client's flat model): a clip angle welded to a beam
  // is a Material row pointing at its parent Material. Null = top-level member.
  parentMaterialId Int?
  parentMaterial   Material?  @relation("MaterialSubparts", fields: [parentMaterialId], references: [id], onDelete: SetNull)
  subparts         Material[] @relation("MaterialSubparts")

  // Fab operations on this material (welding, connections, coatings, etc.)
  fabrication    MaterialFabrication[]

  // Sub-materials (legacy nested model — unused; the flat parentMaterialId
  // linkage above is what the app persists)
  children       ChildMaterial[]

  @@index([itemId, sortOrder])
  @@index([parentMaterialId])
}

// =============================================================================
// MATERIAL FABRICATION
// =============================================================================
// A fabrication operation tied to a specific material.
// Example: "WF Connx — 4 ea @ $85" on a W12x26

model MaterialFabrication {
  id           Int     @id @default(autoincrement())
  sortOrder    Int     @default(0)
  
  operation    String  @default("")       // "WF Connx", "Prime Paint", "Handling", etc.
  quantity     Float   @default(0)
  unit         String  @default("ea")     // "ea", "ft", "sqft", "hr", etc.
  rate         Float   @default(0)        // Cost per unit
  totalCost    Float   @default(0)        // quantity × rate
  
  // Connection-specific fields (for WF Connx, C Connx)
  connWeight   Float   @default(0)        // Weight per connection
  
  // Galvanizing auto-generated line
  isGalvLine   Boolean @default(false)    // True if auto-created for galvanizing
  // Which kind of galv line this is: "auto" (the material/assembly dip line)
  // or "conn" (a galvanized connection op on a NON-galvanized member, which
  // dips alone). Null on ordinary ops. Legacy rows have isGalvLine=true and
  // galvKind=null; the loaders infer the kind from the owning material.
  galvKind     String?
  // For galvKind="conn": the connection op (same material) this line galvanizes.
  // (plain int, no FK: SQLite would rebuild the whole table for a self-relation;
  // the loaders drop a line whose parent op no longer exists.)
  parentFabId  Int?
  // Galvanizing rate class code (GalvRateClass.code) on auto-galv lines;
  // defaulted from the main member, overridable per line / group.
  galvClass    String?

  // Per-op length in inches/feet for IN/LF-unit ops (qty × length × rate)
  length       Float?
  // Connection galvanizing (separate from the material-level galv flag)
  galvanized   Boolean @default(false)
  galvWeight   Float?
  // Child-fab pricing target ('self' or a parent material id, stored as string)
  applyTo      String?

  // Labor group membership (grouped pricing — rate comes from the group)
  laborGroupId Int?
  laborGroup   LaborGroup? @relation(fields: [laborGroupId], references: [id], onDelete: SetNull)

  materialId   Int
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, sortOrder])
}

// =============================================================================
// LABOR GROUP
// =============================================================================
// Grouped fab-op pricing within one item: fab rows on members of the same
// shape family (e.g. all W12s) sharing one operation are priced once as a
// single unit rate. Member rows keep their own quantities; the group rate is
// stamped onto each member's rate and line totals stay per-row.

model LaborGroup {
  id           Int     @id @default(autoincrement())
  sortOrder    Int     @default(0)

  operation    String  @default("")       // "WF Connx", "Cut- Single Cope End", ...
  familyKey    String  @default("")       // Exact size key: "W12x26", "C3x5", "HSS4x4x1/4" (pre-2026-09-02 rows hold family keys like "W12"; split on load)
  unit         String  @default("ea")
  rate         Float   @default(0)        // The single group rate
  collapsed    Boolean @default(false)    // Persisted UI collapse state
  colorIndex   Int     @default(0)        // Stable palette slot

  itemId       Int
  item         Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  fabrications MaterialFabrication[]

  @@index([itemId, sortOrder])
}

// =============================================================================
// CHILD MATERIAL
// =============================================================================
// A sub-material embedded within a parent material.
// Example: Base plate welded to a column, or stiffeners inside a beam.

model ChildMaterial {
  id             Int     @id @default(autoincrement())
  sortOrder      Int     @default(0)

  category       String  @default("")
  shape          String  @default("")
  description    String  @default("")
  length         Float   @default(0)
  pieces         Int     @default(0)
  stockLength    Float   @default(0)
  stocksRequired Int     @default(0)
  waste          Float   @default(0)
  weightPerFt    Float   @default(0)
  fabWeight      Float   @default(0)
  stockWeight    Float   @default(0)
  priceBy        String  @default("LB")
  unitPrice      Float   @default(0)
  pricePerFt     Float   @default(0)
  pricePerLb     Float   @default(0)
  totalCost      Float   @default(0)
  galvanized     Boolean @default(false)
  galvRate       Float   @default(0)
  width          Float?
  thickness      Float?

  // Parent material this belongs to
  parentId       Int
  parent         Material @relation(fields: [parentId], references: [id], onDelete: Cascade)

  // Fab operations on this child material
  fabrication    ChildMaterialFabrication[]

  @@index([parentId, sortOrder])
}

// =============================================================================
// CHILD MATERIAL FABRICATION
// =============================================================================
// Fab operations on a child material (same structure as MaterialFabrication)

model ChildMaterialFabrication {
  id           Int     @id @default(autoincrement())
  sortOrder    Int     @default(0)
  
  operation    String  @default("")
  quantity     Float   @default(0)
  unit         String  @default("ea")
  rate         Float   @default(0)
  totalCost    Float   @default(0)
  connWeight   Float   @default(0)
  isGalvLine   Boolean @default(false)

  // Same lossy-persistence fixes as MaterialFabrication (FINDINGS #9)
  length       Float?
  galvanized   Boolean @default(false)
  galvWeight   Float?
  applyTo      String?

  childMaterialId Int
  childMaterial   ChildMaterial @relation(fields: [childMaterialId], references: [id], onDelete: Cascade)

  @@index([childMaterialId, sortOrder])
}

// =============================================================================
// ITEM FABRICATION
// =============================================================================
// Item-level (general) fabrication — not tied to a specific material.
// Example: "Shop Load-out — 1 LS @ $500" for the whole item.

model ItemFabrication {
  id           Int     @id @default(autoincrement())
  sortOrder    Int     @default(0)
  
  operation    String  @default("")
  quantity     Float   @default(0)
  unit         String  @default("ea")
  rate         Float   @default(0)
  totalCost    Float   @default(0)
  
  itemId       Int
  item         Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

// =============================================================================
// RECAP COST
// =============================================================================
// Per-item costs on the Recap tab — installation, drafting, engineering, etc.
// Also stores custom column values. Each row is one cost category for one item.

model RecapCost {
  id        Int     @id @default(autoincrement())
  
  // Which cost category: "installation", "drafting", "engineering", 
  // "projectManagement", "shipping", or a custom column key like "custom_1707..."
  costType  String
  
  // Standard fields (cost + markup %)
  cost      Float   @default(0)
  markup    Float   @default(0)
  total     Float   @default(0)
  
  // Project Management uses hours × rate instead of cost + markup
  hours     Float   @default(0)
  rate      Float   @default(0)
  
  itemId    Int
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  @@unique([itemId, costType]) // One entry per cost type per item
}

// =============================================================================
// CUSTOM RECAP COLUMN
// =============================================================================
// User-defined columns on the Recap tab (e.g., "Crane", "Permits")

model CustomRecapColumn {
  id        Int     @id @default(autoincrement())
  key       String                        // "custom_1707..." — matches the key in RecapCost.costType
  name      String                        // Display name: "Crane", "Permits", etc.
  
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// =============================================================================
// ADJUSTMENT
// =============================================================================
// General adjustments on the Summary tab (internal only, baked into total)

model Adjustment {
  id          Int     @id @default(autoincrement())
  description String  @default("")
  amount      Float   @default(0)
  
  projectId   Int
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// =============================================================================
// EXCLUSION
// =============================================================================
// Both standard (selected from checkboxes) and custom exclusions

model Exclusion {
  id        Int     @id @default(autoincrement())
  text      String
  isCustom  Boolean @default(false)       // true = user typed it, false = selected from standard list
  
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// =============================================================================
// QUALIFICATION
// =============================================================================
// Both standard and custom qualifications

model Qualification {
  id        Int     @id @default(autoincrement())
  text      String
  isCustom  Boolean @default(false)

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// =============================================================================
// CUSTOM PROJECT TYPE
// =============================================================================
// User-defined project type tags beyond the standard Structural/Misc/Ornamental.

model CustomProjectType {
  id        Int     @id @default(autoincrement())
  text      String

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// =============================================================================
// CUSTOM DELIVERY OPTION
// =============================================================================
// User-defined delivery options beyond Installed / F.O.B. Jobsite / Will Call.
// isSelected tracks which custom option (if any) is currently chosen.

model CustomDeliveryOption {
  id         Int     @id @default(autoincrement())
  text       String
  isSelected Boolean @default(false)

  projectId  Int
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// =============================================================================
// ITEM SNAPSHOT
// =============================================================================
// Blueprint or detail image attached to an item. Stored as base64 so no
// external file storage is required. Multiple snapshots per item, ordered.

model ItemSnapshot {
  id        Int     @id @default(autoincrement())
  sortOrder Int     @default(0)
  imageData String  // base64-encoded JPEG (compressed before storage)
  caption   String  @default("")

  itemId    Int
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

// =============================================================================
// CONNECTION WEIGHTS & PRICING
// =============================================================================
// Lookup tables for connection costs used in estimating W-shapes and C/MC channels.
// PricingRates is a singleton (id=1) that drives all derived cost calculations.

model CustomFabOperation {
  id          Int      @id @default(autoincrement())
  name        String   @unique           // "Sandblast", "Forge", etc.
  category    String   @default("Other") // groups the estimator dropdown optgroup
  defaultUnit String   @default("EA")    // EA, IN, LF, SQFT, HR, LB, LS
  rate        Float    @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingRates {
  id                         Int      @id @default(1)
  shopLaborRatePerHr         Float    @default(65.00)
  materialAvgPricePerLb      Float    @default(0.789)
  quantityDiscountOver20Pct  Float    @default(5.0)
  quantityDiscountOver100Pct Float    @default(7.5)

  // Drilling rates ($/hole)
  drillHolesRate             Float?
  drillCSinkRate             Float?
  drillTapRate               Float?

  // Prep operation rates ($/ea)
  easeRate                   Float?
  spliceRate                 Float?
  ninetyRate                 Float?
  camberRate                 Float?
  rollRate                   Float?

  // Apply (welding) rates ($/in of weld)
  weldFilletRate             Float?
  weldBevelRate              Float?
  weldPjpRate                Float?
  weldCjpRate                Float?
  preheatWeldRate            Float?
  preheatWeldGrindRate       Float?

  // Galvanizer minimum charge per lot (AZZ Houston: $325 eff. 10/01/2025)
  galvMinimumCharge          Float    @default(325)

  updatedAt                  DateTime @updatedAt
  updatedBy                  String?
}

model ConnectionCategory {
  id                   String   @id @default(cuid())
  shapeType            String   // "WF" or "C"
  name                 String   @unique
  shapesIncluded       String
  beamSizeRange        String?
  laborHours           Float
  connxWeightLbs       Int
  momentConnxWeightLbs Int
  providesTakeoffCost  Boolean  @default(false)
  connxCost            Float?
  momentConnxCost      Float?

  // All-in per-connection prices (replace connxCost in the UI; connxCost stays
  // for legacy "WF Connx"/"C Connx" ops). Sourced from linked Connx Template
  // items via sync, or entered manually. momentConnxCost doubles as the CJP price.
  boltedConnxCost       Float?
  weldedConnxCost       Float?
  boltedTemplateItemId  Int?
  weldedTemplateItemId  Int?
  boltedSyncedAt        DateTime?
  weldedSyncedAt        DateTime?
  singleCopeCost       Float
  doubleCopeCost       Float
  straightCutCost      Float
  miterCutCost         Float
  doubleMiterCost      Float
  singleCopeMiterCost  Float
  doubleCopeMiterCost  Float
  beams                BeamConnectionData[]
  updatedAt            DateTime @updatedAt

  @@index([shapeType])
}

model BeamConnectionData {
  id                       String             @id @default(cuid())
  beamSize                 String             @unique
  shapeType                String
  categoryId               String
  category                 ConnectionCategory @relation(fields: [categoryId], references: [id])
  connxWeightLbs           Int
  momentConnxWeightLbs     Int
  connxCostProvideTO       Boolean            @default(false)
  connxCost                Float?
  momentConnxCostProvideTO Boolean            @default(false)
  momentConnxCost          Float?
  singleCopeCost           Float
  doubleCopeCost           Float
  straightCutCost          Float?
  miterCutCost             Float?
  doubleMiterCost          Float?
  singleCopeMiterCost      Float?
  doubleCopeMiterCost      Float?
  updatedAt                DateTime           @updatedAt

  @@index([shapeType])
}

// =============================================================================
// NOTIFICATION
// =============================================================================
// In-app notifications for status-change events (submit, recall, publish, reopen).
// Delivered to the right users based on their role and project assignment.

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  recipient   User     @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
}

// =============================================================================
// CRM — CUSTOMER
// =============================================================================
// A company/customer that can be linked to multiple projects.

model Customer {
  id          Int       @id @default(autoincrement())
  name        String
  shortName   String?
  address     String?
  city        String?
  state       String?
  zip         String?
  phone       String?
  website     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contacts    CustomerContact[]
  activities  CustomerActivity[]
  projects    Project[]

  @@index([name])
}

// =============================================================================
// CRM — CUSTOMER CONTACT
// =============================================================================
// Individual contacts at a customer company.

model CustomerContact {
  id          Int       @id @default(autoincrement())
  customerId  Int
  firstName   String
  lastName    String
  title       String?
  email       String?
  phone       String?
  mobile      String?
  isPrimary   Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// =============================================================================
// CRM — CUSTOMER ACTIVITY
// =============================================================================
// Activity log: notes, calls, emails, meetings, bid events, follow-ups.

model CustomerActivity {
  id            Int       @id @default(autoincrement())
  customerId    Int
  projectId     Int?
  type          String    // NOTE, CALL, EMAIL, MEETING, BID_RECEIVED, BID_SUBMITTED, FOLLOW_UP
  description   String
  activityDate  DateTime  @default(now())
  followUpDate  DateTime?
  completedAt   DateTime?
  createdById   Int
  createdAt     DateTime  @default(now())

  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy     User      @relation(fields: [createdById], references: [id])

  @@index([customerId, activityDate])
  @@index([followUpDate])
  @@index([createdById])
}

// Galvanizer rate classes (Global Pricing Data → Galvanizing). Seeded from the
// AZZ Houston sheet (docs/galv-rate-sheet.pdf); Berger edits ratePerCwt to its
// all-in number (environmental fee, handling, etc. baked in). Galv labor groups
// key on the class code; the line rate is ratePerCwt / 100 per lb.
model GalvRateClass {
  id         Int      @id @default(autoincrement())
  code       String   @unique          // KDS, MSC, FPIP5, FTUB3, ... MLT
  name       String
  ratePerCwt Float    @default(0)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}
